{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "faf-server-card-ref",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  // Custom domain — the card derives its own host, so it self-describes at
  // context.faf.one (card → context.faf.one/mcp/server-card; remotes → /mcp).
  "routes": [{ "pattern": "context.faf.one", "custom_domain": true }],
  // The host is shared: paths the card doesn't own (/, the page's routes) go to
  // the repo-to-context Worker. Without this binding the card serves / itself.
  "services": [{ "binding": "PAGE", "service": "context" }],
  // Workers Builds runs `npx wrangler preview` on PRs; wrangler 4.157+ requires
  // this block. Empty is safe: no secrets; the one binding (PAGE) is a service.
  "previews": {}
}
