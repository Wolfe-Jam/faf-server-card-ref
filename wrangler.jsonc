{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "faf-server-card-ref",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  // Custom domain — the card derives its own host, so it self-describes at
  // context.faf.one (card → context.faf.one/mcp/server-card; remotes → /mcp).
  "routes": [{ "pattern": "context.faf.one", "custom_domain": true }]
}
